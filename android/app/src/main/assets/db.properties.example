# Copie este archivo como "db.properties" (en esta misma carpeta) y ajuste los valores.
# db.properties NO se sube a git (esta en .gitignore): aqui van los datos de SU maquina.
# Si no existe, la app usa los valores por defecto que se muestran abajo.
#
# host:    10.0.2.2 es el computador visto desde el EMULADOR de Android (valor por defecto).
#          Con un telefono real, ponga la IP del computador en la red wifi (ej. 192.168.1.20).
# clave:   contrasena de MySQL. Vacia = root sin contrasena (igual que el programa de escritorio).
host=10.0.2.2
puerto=3306
base=sistema_ventas
usuario=root
clave=
