<?xml version="1.0" encoding="utf-8"?>
<!--
    Android bloquea por defecto el trafico http sin cifrar. La app solo habla con la API
    del computador a traves del cable USB (adb reverse), que llega como 127.0.0.1 dentro
    del telefono; por eso se permite http UNICAMENTE hacia esa direccion.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
